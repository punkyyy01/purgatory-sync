# Copiá a .env para correr local: cp .env.example .env
# En Railway estas van como variables de entorno del servicio, no como archivo.

# Token del bot — https://discord.com/developers/applications → tu app → Bot → Reset Token
# Pegá SOLO el token, sin prefijo "Bot " y sin comillas.
DISCORD_BOT_TOKEN=

# ID numérico del servidor de PURG4TORY (clic derecho sobre el server → Copiar ID,
# necesita modo desarrollador activado en Discord).
DISCORD_GUILD_ID=

# Connection string DIRECTA de Postgres en Supabase (puerto 5432, no el pooler
# 6543) — Project Settings → Database → Connection string → "URI".
DATABASE_URL=

# Cada cuántas horas corre la reconciliación completa (además de al arrancar).
RECONCILE_INTERVAL_HOURS=6
